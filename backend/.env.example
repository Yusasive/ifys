# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://ify:ify_dev_password@localhost:5433/ify_summit?schema=public"

REDIS_URL="redis://localhost:6380"

S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ify-summit-uploads"
S3_ACCESS_KEY_ID="ify_minio"
S3_SECRET_ACCESS_KEY="ify_minio_password"
S3_FORCE_PATH_STYLE="true"

CORS_ORIGIN="http://localhost:3001"

EVENT_SLUG="ify-summit-2026"

FRONTEND_ORIGIN="http://localhost:3001"

# Get test keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Local dev: Mailpit (see docker-compose.yml), no auth required
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="tickets@ifysummit.ng"
# MUST be a real, monitored inbox before event day — this is the only
# contact an attendee has if their ticket email is wrong (TRD §7, M6).
SUPPORT_EMAIL="support@ifysummit.ng"

# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-random-64-char-hex-string"
JWT_EXPIRES_IN="28800" # seconds (8h)
