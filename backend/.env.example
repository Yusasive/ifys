# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://ify:ify_dev_password@localhost:5433/ify_summit?schema=public"

REDIS_URL="redis://localhost:6380"

# Local dev: MinIO (see docker-compose.yml).
# Production (Cloudflare R2): create the bucket + an API token under
# R2 > Manage R2 API Tokens (Object Read & Write), then:
#   S3_ENDPOINT   = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION     = auto
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY = the R2 token's key pair
#   S3_FORCE_PATH_STYLE stays "true" — R2 routes bucket-by-path, not by subdomain.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ify-summit-uploads"
S3_ACCESS_KEY_ID="ify_minio"
S3_SECRET_ACCESS_KEY="ify_minio_password"
S3_FORCE_PATH_STYLE="true"

CORS_ORIGIN="http://localhost:3001"

EVENT_SLUG="ify-summit-2026"

FRONTEND_ORIGIN="http://localhost:3001"

# Get test keys from https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
# Set under Settings > Webhooks in the Flutterwave dashboard; the same
# value must be configured there so it's echoed back in the `verif-hash`
# header on every webhook delivery.
FLUTTERWAVE_WEBHOOK_HASH="replace-with-a-random-secret-string"

# Local dev: Mailpit (see docker-compose.yml), no auth required
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_USER="contact@ifysummit.com"      # your full Zoho mailbox address
SMTP_PASSWORD="<the app-specific password>"
SMTP_FROM="contact@ifysummit.com"


# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-random-64-char-hex-string"
JWT_EXPIRES_IN="28800" # seconds (8h)
